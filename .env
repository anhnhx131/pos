### Compose topology selection
COMPOSE_FILE=geth.yml:lighthouse-bn-only.yml:lighthouse.yml:dora.yml

### Global defaults
NETWORK=joc
LOG_LEVEL=info
HOST_IP=
FEE_RECIPIENT=0x0000000000000000000000000000000000000000
MEV_BOOST=false
MEV_NODE=
MEV_BUILD_FACTOR=0
BEACON_STATS_API=
BEACON_STATS_MACHINE=
CL_MAX_PEER_COUNT=64
CL_ARCHIVE_NODE=false
IPV6=false
CL_EXTRAS=
VC_EXTRAS=
CL_ALIAS=joc-consensus
DOMAIN=localhost

### Shared paths
GETH_DATA_DIR=./data/el/geth
EL_CONFIG_DIR=./config/el
LH_CONSENSUS_DATA_DIR=./data/cl/consensus
VALIDATOR_DATA_DIR=./data/cl/validator
BOOTNODE_DATA_DIR=./data/cl/bootnode
LH_CONFIG_DIR=./config/lighthouse
JWT_SECRET_DIR=./shared/jwt
DORA_CONFIG_FILE=./dora/config.yaml
DORA_DATA_DIR=./dora/data

### Execution-layer (geth)
GETH_IMAGE=ethereum/client-go:v1.11.6
EL_NETWORK_ID=32382
EL_GENESIS_FILE=genesis.json
EL_GENESIS_JSON=
EL_BOOTNODES=
EL_HTTP_PORT=8545
EL_WS_PORT=8546
EL_AUTH_RPC_PORT=8551
EL_METRICS_PORT=6060
EL_HTTP_APIS=eth,net,web3,engine,admin,debug,txpool
EL_SYNC_MODE=full
EL_GC_MODE=full
EL_EXTRAS=
JWT_SECRET_FILENAME=jwtsecret
JWT_SECRET=

### Bootnode parameters
LH_IMAGE=sigp/lighthouse:v7.0.1
BOOTNODE_LISTEN_ADDRESS=0.0.0.0
BOOTNODE_ENR_ADDRESS=bootnode
BOOTNODE_P2P_PORT=9000
BOOTNODE_ENR=

### Consensus node
CL_REST_PORT=5052
CL_P2P_PORT=9000
CL_QUIC_PORT=9001
CL_TESTNET_DIR=/config
EL_NODE=http://execution:8551
CHECKPOINT_SYNC_URL=
ARCHIVE_NODE=false

### Validator client
CL_NODE=http://consensus:5052
VC_ALIAS=vc
VC_HOST=vc
KEY_API_PORT=7500
DOPPELGANGER=false
ENABLE_DIST_ATTESTATION_AGGR=false
GRAFFITI=
DEFAULT_GRAFFITI=false
KEYSTORE_PASSWORD=
W3S_NODE=

### Dora explorer
DORA_IMAGE=pk910/dora-the-explorer:latest
DORA_HOST_PORT=3000

### Validator import helpers
VALIDATOR_PASSWORD_FILENAME=password.txt
VALIDATOR_KEYSTORE_FILENAME=keystore.json
VALIDATOR_KEY_JSON=
VALIDATOR_KEY_PASSWORD=

BOOTNODE_IP=0.0.0.0